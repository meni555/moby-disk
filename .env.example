# Moby Disk – Beispiel für die .env (Rechte: chmod 600). Details zu jeder Variable: docs/installation.md und docs/targets.md
#
# Die Ziele lassen sich auch im Webinterface einrichten (Einstellungen → Backup-Ziele); Werte dort haben Vorrang vor dieser Datei.
# Hier: nur die Werte der Ziele ausfüllen, die in TARGETS aktiv sind. Leere Zeilen gelten als
# „nicht gesetzt“ und stören nicht. Zugangsdaten bitte NUR hier eintragen (nicht in compose/Portainer) – Änderungen dort
# gehen beim nächsten Neuerstellen des Containers verloren. Nach einer Änderung: docker compose up -d

# Pflicht: Passwort für das Webinterface (bitte ändern!)
APP_PASSWORD=changeme

# Session-Geheimnis (optional; leer = zufällig pro Neustart, danach ist ein erneuter Login nötig)
SESSION_SECRET=

# Zeitzone für Zeitpläne und Anzeige
TZ=Europe/Berlin

# Aktive Backup-Ziele, kommagetrennt: commvault, veeam, pbs, restic, command
TARGETS=commvault

# ── Ziel Commvault ──────────────────────────────────────────────
# WebServer (CommServe/WebConsole-Host)
CV_URL=
# Pfad des REST-Webservice
CV_WEBSERVICE_PATH=/SearchSvc/CVWebService.svc
CV_USERNAME=
CV_PASSWORD=
# TLS-Zertifikat prüfen (bei selbstsignierten Zertifikaten false)
CV_VERIFY_TLS=false
# Optional: fest verdrahten statt Auswahl im Webinterface (29 = Linux File System, 33 = Windows File System)
CV_CLIENT_ID=
CV_SUBCLIENT_ID=
CV_APP_TYPE_ID=
CV_INSTANCE_ID=
CV_BACKUP_SET_ID=

# ── Ziel Veeam (Backup & Replication, REST-API) ─────────────────
# Beispiel: https://vbr.example.com:9419
VEEAM_URL=
# Meist mit Domäne bzw. Rechnernamen: DOMAIN\benutzer, benutzer@domain oder RECHNERNAME\benutzer
VEEAM_USERNAME=
VEEAM_PASSWORD=
# Name oder ID des Jobs, der BACKUP_ROOT sichert
VEEAM_JOB=
VEEAM_VERIFY_TLS=false
# Leer = automatisch die höchste Version des Servers (nötig für Datei-/Agent-Jobs: ab 1.3)
VEEAM_API_VERSION=
VEEAM_POLL_SECONDS=

# ── Ziel Proxmox Backup Server ──────────────────────────────────
# Benutzer@Realm!Token@Server:Port:Datastore, z. B. backup@pbs!moby@pbs.example.com:8007:docker
PBS_REPOSITORY=
# Geheimnis des API-Tokens (oder Passwort)
PBS_PASSWORD=
# SHA-256-Fingerabdruck des Server-Zertifikats (bei selbstsigniertem Zertifikat)
PBS_FINGERPRINT=
PBS_NAMESPACE=
# Optional: clientseitige Verschlüsselung (Schlüsseldatei, z. B. /data/pbs.key, und Passwort dazu)
PBS_KEYFILE=
PBS_ENCRYPTION_PASSWORD=
# Aufbewahrung je Container, z. B. "--keep-last 14 --keep-monthly 6" (leer = nichts löschen)
PBS_KEEP=

# ── Ziel restic ─────────────────────────────────────────────────
# Lokal /mnt/backup/restic oder sftp:user@host:/pfad, s3:https://minio:9000/bucket, rest:https://…
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Fehlendes Repository beim ersten Lauf anlegen (true/false)
RESTIC_AUTO_INIT=
# Aufbewahrung im Repository, z. B. "--keep-daily 14 --keep-monthly 6" (leer = nichts löschen)
RESTIC_KEEP=
# Zugangsdaten des Speichers, falls nötig (S3 u. a.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Ziel Befehl/Skript (siehe docs/targets.md) ──────────────────
# Anzeigename, z. B. Bacula
COMMAND_LABEL=
# z. B. /scripts/start.sh
COMMAND_START=
COMMAND_STATUS=
# z. B. /scripts/list.sh {container}
COMMAND_LIST=
# z. B. /scripts/fetch.sh {container} {folder} {dest}
COMMAND_FETCH=
COMMAND_POLL_SECONDS=
COMMAND_TIMEOUT=
